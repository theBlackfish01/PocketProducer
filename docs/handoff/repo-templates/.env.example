# Template only. Match names to implemented configuration schemas.
# Never commit a populated .env or expose server values through VITE_*.
# Preserve the user's existing environment file; merge missing names only.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
AUDIOTOOL_CLIENT_ID=
AUDIOTOOL_REDIRECT_URL=http://127.0.0.1:5173/
AUDIOTOOL_SCOPES=
# Determine and verify needed scopes; do not guess scope spellings.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_ROOT=./.local/audio
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pocket-producer-dev
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=
FFMPEG_PATH=ffmpeg
WORKER_CONCURRENCY=1
MAX_MODEL_CALLS_PER_JOB=8
MAX_RENDER_ATTEMPTS_PER_JOB=2
MAX_AUDIO_CRITIQUE_PASSES=1
MAX_JOB_SECONDS=300
MAX_UPLOAD_BYTES=104857600
MAX_SOURCE_SECONDS=300
MAX_SOURCES_PER_PROJECT=12
MAX_OUTPUT_SECONDS=60
# Zero caps mean paid execution is disabled until configured/authorized.
# The launch prompt proposes a $5 total initial application API-test cap.
# Configure that allowance only when authorized by the prompt; stricter settings win.
INITIAL_BUILD_API_BUDGET_USD=0
MAX_JOB_COST_USD=0
MAX_DAILY_COST_USD=0
DEV_LOCAL_AUTH=false
FIXTURE_MODE=false
LOG_LEVEL=info
