# Safe first-run template. Copy only if .env does not already exist.
# All credentials are server-only; never use a VITE_* prefix for secrets.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=8787
DATABASE_URL=postgresql://pocket:pocket_local_only@127.0.0.1:54329/pocket_producer
OBJECT_STORAGE_LOCAL_ROOT=./.local/audio
DEV_LOCAL_AUTH=true

# Deterministic, provider-free demonstration. Set false only for intentional live use.
FIXTURE_MODE=true
INITIAL_BUILD_API_BUDGET_USD=0
MAX_JOB_COST_USD=0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Provider/owner lifetime caps apply together with the combined and job caps.
# These are application limits, not synchronized provider wallet balances.
# OPENAI_POOL_BUDGET_USD=0
GEMINI_POOL_BUDGET_USD=0
GATEWAY_POOL_BUDGET_USD=0
DEFAULT_USER_BUDGET_USD=0
# Retained only for existing Gateway jobs; DeepSeek is no longer selectable.
AI_GATEWAY_API_KEY=
# VERCEL_AI_GATEWAY_API_KEY=

# Optional explicit Audiotool connection/copy. OAuth tokens are encrypted locally.
AUDIOTOOL_CLIENT_ID=
AUDIOTOOL_REDIRECT_URL=http://127.0.0.1:5173/auth/audiotool/callback
AUDIOTOOL_SCOPES=user:read project:write project:read sample:write sample:read preset:read preset:write

# Optional private diagnostics; ordinary tests disable tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pocket-producer-dev
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_TRACING_SAMPLING_RATE=1

WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=45
MAX_MODEL_CALLS_PER_JOB=80
NATIVE_MODEL_OUTPUT_TOKENS=32768
MAX_OPENAI_INPUT_TOKENS=96000
NATIVE_REASONING_EFFORT=medium
MAX_JOB_SECONDS=3600
MAX_UPLOAD_BYTES=20971520
MAX_SOURCE_SECONDS=300
GEMINI_ESTIMATED_CALL_COST_USD=0.05
