# Template only. Match names to implemented configuration schemas.
# Never commit a populated .env or expose server values through VITE_*.
# Preserve the user's existing environment file; merge missing names only.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://pocket:pocket_local_only@127.0.0.1:54329/pocket_producer
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
AUDIOTOOL_CLIENT_ID=
AUDIOTOOL_REDIRECT_URL=http://127.0.0.1:5173/auth/audiotool/callback
AUDIOTOOL_SCOPES=project:write
# This is the one scope documented by Nexus 0.0.17 for project creation/editing.
# Stem-upload scope behavior still requires the first authorized account test.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_ROOT=./.local/audio
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pocket-producer-dev
# Set LANGSMITH_ENDPOINT for a non-US LangSmith region; use WORKSPACE_ID
# only when the key belongs to multiple workspaces.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# Trace payloads can include directions, owned-source metadata and tool output.
# These default to true in server code; false explicitly opts into payload capture.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional: 0..1; unset means all enabled producer traces.
# LANGSMITH_TRACING_SAMPLING_RATE=1
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=
FFMPEG_PATH=ffmpeg
WORKER_CONCURRENCY=1
MAX_MODEL_CALLS_PER_JOB=80
NATIVE_MODEL_OUTPUT_TOKENS=32768
MAX_OPENAI_INPUT_TOKENS=96000
NATIVE_REASONING_EFFORT=medium
MAX_JOB_SECONDS=3600
MAX_UPLOAD_BYTES=104857600
MAX_SOURCE_SECONDS=300
MAX_SOURCES_PER_PROJECT=12
# Zero caps mean paid execution is disabled until configured/authorized.
# The launch prompt proposes a $5 total initial application API-test cap.
# Configure that allowance only when authorized by the prompt; stricter settings win.
INITIAL_BUILD_API_BUDGET_USD=0
MAX_JOB_COST_USD=0
GEMINI_ESTIMATED_CALL_COST_USD=0.05
MAX_DAILY_COST_USD=0
DEV_LOCAL_AUTH=true
FIXTURE_MODE=false
LOG_LEVEL=info
