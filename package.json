{
  "name": "pocket-producer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c green,magenta,cyan \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @pocket/api dev",
    "dev:worker": "pnpm --filter @pocket/worker dev",
    "dev:web": "pnpm --filter @pocket/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude tests/integration/** --exclude tests/e2e/**",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:live": "tsx scripts/live-provider-smoke.ts",
    "build": "pnpm --filter @pocket/web build && tsc -b",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@pocket/core": "workspace:*",
    "@types/node": "24.7.0",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
